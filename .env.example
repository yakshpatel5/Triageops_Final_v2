# TriageOps v1.0 — complete environment reference
# Copy to .env — never commit .env to git

APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

DATABASE_URL=postgresql://triageops:triageops_dev@localhost:5432/triageops
POSTGRES_PASSWORD=triageops_dev

REDIS_URL=redis://localhost:6379/0

BOOTSTRAP_API_KEY=dev-bootstrap-key-change-me

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-11-20

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_ALERT_CHANNEL=#noc-triage
SLACK_CHANNEL_CRITICAL=#noc-critical
SLACK_CHANNEL_NOISE=#noc-noise
APPROVAL_TTL_HOURS=24

PAGERDUTY_ROUTING_KEY=
OPSGENIE_API_KEY=
OPSGENIE_API_URL=https://api.opsgenie.com
OPSGENIE_RESPONDERS=
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=

RATE_LIMITING_ENABLED=true
RATE_LIMIT_WEBHOOK_PER_MIN=100
RATE_LIMIT_OPS_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=200

CORS_ALLOWED_ORIGINS=https://noc.yourdomain.com

# ---------------------------------------------------------------------------
# Microsoft Teams (optional — works alongside or instead of Slack)
# ---------------------------------------------------------------------------
# Get URL from: Teams channel → ··· menu → Connectors → Incoming Webhook → Configure
# V1: notification-only. Interactive approval buttons require Bot Framework (v1.2).
TEAMS_WEBHOOK_URL=
# URL embedded in the Teams card "View in Dashboard" button
TRIAGEOPS_DASHBOARD_URL=https://your-railway-url.up.railway.app/dashboard

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SQL_ECHO=false

FLOWER_USER=admin
FLOWER_PASSWORD=change-me
